{
  "name": "geography-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "scripts/await-setup.sh vite",
    "build": "scripts/slot.sh build vite build",
    "build:pages": "scripts/slot.sh build vite build --base=/geography-trainer/ && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "typecheck": "scripts/slot.sh typecheck tsc -p tsconfig.app.json --noEmit && scripts/slot.sh typecheck tsc -p tsconfig.node.json --noEmit",
    "lint": "scripts/slot.sh lint eslint",
    "test": "scripts/slot.sh test vitest run",
    "test:e2e": "scripts/slot.sh e2e playwright test",
    "verify": "npm run spec:check && npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "format": "prettier --write .",
    "build:data": "scripts/slot.sh build-data tsx scripts/build-data/index.ts",
    "spec:check": "scripts/await-setup.sh tsx scripts/spec-check/index.ts"
  },
  "dependencies": {
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "d3-geo": "3.1.2",
    "dexie": "4.4.7",
    "maplibre-gl": "6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "topojson-client": "^3.1.0",
    "ts-fsrs": "6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "6.2.8",
    "mapshaper": "^0.8.10",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
